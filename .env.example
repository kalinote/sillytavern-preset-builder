# 默认仅本机可访问。可信局域网使用时可改为 0.0.0.0；本项目第一版没有登录鉴权。
PRESET_STUDIO_BIND=127.0.0.1
PRESET_STUDIO_PORT=3001

# 映射到容器 /app/workspace-data 的宿主机持久化目录。
PRESET_STUDIO_WORKSPACE_HOST=./workspace-data

# 需要大于待导入 preset 的 JSON 请求体大小。
PRESET_STUDIO_BODY_LIMIT_MIB=64

# 工程 ZIP 安全限额。
PRESET_STUDIO_ZIP_MAX_MIB=64
PRESET_STUDIO_ZIP_UNPACKED_MIB=256
PRESET_STUDIO_ZIP_FILE_MIB=128
PRESET_STUDIO_ZIP_MAX_ENTRIES=10000
