# 默认仅本机可访问。可信局域网使用时可改为 0.0.0.0；
PRESET_STUDIO_BIND=127.0.0.1
PRESET_STUDIO_PORT=3001

# 仅供无 ST 会话的工程 API 跨源调用（逗号分隔）；ST 会话 UI 必须同源反代 /api，通常保持为空。
PRESET_STUDIO_ALLOWED_ORIGINS=
PRESET_STUDIO_EXPOSE_WORKSPACE_PATH=false

# 映射到容器 /app/workspace-data 的宿主机持久化目录。
PRESET_STUDIO_WORKSPACE_HOST=./workspace-data

# 容器写入 bind mount 所用的宿主机 UID/GID；按宿主机目录所有者调整。
PRESET_STUDIO_UID=1000
PRESET_STUDIO_GID=1000

# 需要大于待导入 preset 的 JSON 请求体大小。
PRESET_STUDIO_BODY_LIMIT_MIB=64

# 工程 ZIP 安全限额。
PRESET_STUDIO_ZIP_MAX_MIB=64
PRESET_STUDIO_ZIP_UNPACKED_MIB=256
PRESET_STUDIO_ZIP_FILE_MIB=128
PRESET_STUDIO_ZIP_MAX_ENTRIES=10000

# Node 直连 SillyTavern 的目标限制。默认 allowlist 只允许回环地址和下面精确列出的 Origin。
# private 额外允许 IPv4 RFC1918 / IPv6 ULA；any 会允许其他 HTTP(S) 目标，只能在完全可信的网络中显式使用。
# link-local、unspecified、multicast/reserved 和云 metadata 地址在所有策略下始终拒绝。
PRESET_STUDIO_ST_TARGET_POLICY=allowlist
PRESET_STUDIO_ST_ALLOWED_ORIGINS=

# 直连 ST 的网络与内存会话限额
PRESET_STUDIO_ST_CONNECT_TIMEOUT_MS=10000
PRESET_STUDIO_ST_REQUEST_TIMEOUT_MS=30000
PRESET_STUDIO_ST_RESPONSE_LIMIT_MIB=64
PRESET_STUDIO_ST_SESSION_IDLE_MINUTES=480
